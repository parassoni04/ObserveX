# ─────────────────────────────────────────────────
# ObserveX Server — Environment Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and customize for your environment.
# NEVER commit your actual .env file to version control!
# ─────────────────────────────────────────────────

# ── Environment Mode ──
ENVIRONMENT=development

# ── Database ──
DATABASE_URL=postgresql+asyncpg://observex:observex_secret@localhost:5432/observex

# ── Server ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
METRIC_RETENTION_DAYS=7

# ── CORS ──
# In production, set specific origins (comma-separated).
# NEVER use "*" in production with authenticated endpoints!
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ── JWT Authentication ──
# ⚠️  CRITICAL: Set a strong random secret in production!
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# In development, an ephemeral secret is auto-generated if left blank.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Heartbeat State Machine (seconds) ──
HEARTBEAT_ONLINE_TIMEOUT=30
HEARTBEAT_STALE_TIMEOUT=120
HEARTBEAT_CHECK_INTERVAL=15

# ── WebSocket Protocol ──
WS_HEARTBEAT_INTERVAL=15
WS_HEARTBEAT_TIMEOUT=45
WS_MAX_MESSAGE_SIZE=65536

# ── Enrollment ──
ENROLLMENT_CODE_TTL_HOURS=24

# ── Remediation Command Allowlist ──
ALLOWED_REMEDIATION_ACTIONS=restart_service,kill_process,cleanup_temp

# ── Logging ──
# OBSERVEX_LOG_FILE=/var/log/observex/server.log
