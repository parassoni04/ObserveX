# ── Server ──
DATABASE_URL=postgresql+asyncpg://observex:observex_secret@localhost:5432/observex
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
METRIC_RETENTION_DAYS=7
CORS_ORIGINS=*
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret-key-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Heartbeat state machine (seconds)
HEARTBEAT_ONLINE_TIMEOUT=30
HEARTBEAT_STALE_TIMEOUT=120
HEARTBEAT_CHECK_INTERVAL=15

# Enrollment
ENROLLMENT_CODE_TTL_HOURS=24

# ── Agent ──
OBSERVEX_SERVER_URL=http://localhost:8000
# OBSERVEX_DEVICE_CREDENTIAL=  (set after enrollment)
OBSERVEX_DEVICE_NAME=
OBSERVEX_METRICS_INTERVAL=1.0
OBSERVEX_HEARTBEAT_INTERVAL=10.0
OBSERVEX_LOG_LEVEL=INFO
OBSERVEX_VERIFY_SSL=true
